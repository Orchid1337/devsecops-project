{
  "dashboard": {
    "id": null,
    "title": "DevSecOps Security Dashboard",
    "tags": ["security", "devsecops", "containers"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Nginx Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"nginx\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Active Connections",
        "type": "timeseries",
        "targets": [
          {
            "expr": "nginx_connections_active",
            "refId": "A"
          }
        ]
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  }
}
